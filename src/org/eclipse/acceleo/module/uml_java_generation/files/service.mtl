[module service('http://www.eclipse.org/uml2/5.0.0/UML')]

[template public generateService(aClass : Class)]
[file ('src/main/java/com/example/service/' + aClass.name + 'Service.java', false, 'UTF-8')]
package com.example.service;

import java.util.List;
import com.example.model.[aClass.name/];

